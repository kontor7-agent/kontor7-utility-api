    "/text-clean": {
      "post": {
        "summary": "Text cleaner",
        "description": "Unicode NFC, remove control/zero-width chars, normalise quotes/dashes/whitespace, optional lowercase and line de-duplication. Price: $0.01 USDC per call (x402).",
        "requestBody": {
          "required": true,
