    },
    "/token-count": {
      "post": {
        "summary": "LLM token counter",
        "description": "Count tokens with OpenAI tokenizers (o200k_base default, cl100k_base optional) and estimate cost for a given price per million. Price: $0.01 USDC per call (x402).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "text": "Count my tokens, please.",
                "encoding": "o200k_base",
                "price_per_million_usd": 2.5
