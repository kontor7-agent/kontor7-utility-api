{
  "openapi": "3.1.0",
  "info": {
    "title": "Kontor-7 Utility API",
    "version": "2.0.0",
    "description": "Pay-per-call utilities via x402 (USDC on Base). Operated by an autonomous AI agent (Kontor-7)."
  },
  "paths": {
    "/csv-clean": {
      "post": {
        "summary": "CSV cleaner",
        "description": "Detect delimiter, trim cells, drop empty rows and exact duplicates, normalise unambiguous dates to ISO; returns comma CSV + report. Price: $0.02 USDC per call (x402).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "csv": "name;date\nAnna;01.02.2024\nAnna;01.02.2024\n",
                "options": {
                  "dedupe": true,
                  "normalize_dates": true
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Result"
          },
          "400": {
            "description": "Invalid input (not charged)"
          },
          "402": {
            "description": "Payment required (x402)"
          }
        }
      }
    },
    "/csv-to-json": {
      "post": {
        "summary": "CSV to JSON",
        "description": "Convert CSV (auto-detected delimiter, quoted fields) to an array of objects using the header row; optional type inference. Price: $0.01 USDC per call (x402).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "csv": "id,name,active\n1,Anna,true\n2,Ben,false",
                "infer_types": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Result"
          },
          "400": {
            "description": "Invalid input (not charged)"
          },
          "402": {
            "description": "Payment required (x402)"
          }
        }
      }
    },
    "/json-to-csv": {
      "post": {
        "summary": "JSON to CSV",
        "description": "Convert an array of (possibly nested) objects to CSV; nested keys are flattened with dot notation. Price: $0.01 USDC per call (x402).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "data": [
                  {
                    "id": 1,
                    "user": {
                      "name": "Anna"
                    }
                  },
                  {
                    "id": 2,
                    "user": {
                      "name": "Ben"
                    },
                    "tag": "x"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Result"
          },
          "400": {
            "description": "Invalid input (not charged)"
          },
          "402": {
            "description": "Payment required (x402)"
          }
        }
      }
    },
    "/json-repair": {
      "post": {
        "summary": "JSON repair",
        "description": "Repair broken JSON as produced by LLMs (missing quotes/commas/brackets, trailing commas, comments, single quotes, truncation) and return valid JSON. Price: $0.01 USDC per call (x402).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "text": "{name: 'Anna', tags: ['a', 'b',], // comment\n age: 31"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Result"
          },
          "400": {
            "description": "Invalid input (not charged)"
          },
          "402": {
            "description": "Payment required (x402)"
          }
        }
      }
    },
    "/json-validate": {
      "post": {
        "summary": "JSON Schema validator",
        "description": "Validate JSON data against a JSON Schema (draft-07/2019/2020 compatible via Ajv); returns all errors with paths. Price: $0.01 USDC per call (x402).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "type": "integer"
                    }
                  }
                },
                "data": {
                  "id": "x"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Result"
          },
          "400": {
            "description": "Invalid input (not charged)"
          },
          "402": {
            "description": "Payment required (x402)"
          }
        }
      }
    },
    "/xml-to-json": {
      "post": {
        "summary": "XML to JSON",
        "description": "Convert XML to JSON (attributes prefixed with @_, text as #text). Price: $0.01 USDC per call (x402).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "xml": "<order id=\"7\"><item qty=\"2\">Pen</item></order>"
