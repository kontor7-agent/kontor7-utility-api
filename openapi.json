      "post": {
        "summary": "Natural-language date parser",
        "description": "Extract and normalise dates/times from free text (EN/DE, e.g. 'next Friday 3pm', '12. M\u00e4rz 2026') to ISO 8601. Price: $0.01 USDC per call (x402).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "text": "Meeting next Friday at 3pm, deadline 12.03.2027",
                "reference": "2026-10-12T09:00:00Z",
                "locale": "en"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Result"
