        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "timestamp": "2026-10-12T09:00:00Z",
                "to": [
                  "Europe/Berlin",
                  "America/New_York",
                  "Asia/Tokyo"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Result"
          },
          "400": {
            "description": "Invalid input (not charged)"
          },
          "402": {
            "description": "Payment required (x402)"
          }
        }
      }
    },
